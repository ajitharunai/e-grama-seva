generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid())
  employeeId   String   @unique
  name         String
  passwordHash String
  role         String   @default("ADMIN") // ADMIN, OFFICER
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  
  assignedComplaints Complaint[]
}

model Citizen {
  id                 String   @id @default(uuid())
  citizenId          String   @unique
  passwordHash       String?
  fullName           String
  dob                DateTime
  gender             String
  maritalStatus      String
  fathersName        String
  aadhaar            String   @unique
  mobileNumber       String?
  bloodGroup         String?
  religion           String?
  caste              String?
  
  // Household Info
  wardNumber         String
  houseNumber        String
  pincode            String
  houseOwnership     String   // OWNED, RENTED
  rationCardType     String   // APL, BPL
  familyMembersCount Int
  annualIncome       Float
  
  // Education & Work
  educationLevel     String?
  schoolName         String?
  occupation         String?
  monthlyIncome      Float?
  
  isActive           Boolean  @default(true)
  photoUrl           String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  complaints         Complaint[]
  certificates       CertificateApplication[]
  taxes              TaxRecord[]
  studentRecords     StudentRecord[]
}

model StudentRecord {
  id              String   @id @default(uuid())
  level           String   // SSLC, HSC, COLLEGE
  stream          String?  // Arts and Science, Engineering, Medicine, Law
  institutionName String
  yearOfStudy     String?
  completionYear  Int?
  
  citizenId       String
  citizen         Citizen  @relation(fields: [citizenId], references: [id])
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Complaint {
  id               String   @id @default(uuid())
  complaintId      String   @unique
  category         String   // Road, Water, Electricity, Sanitation
  description      String
  wardNumber       String
  priority         String   // HIGH, MEDIUM, LOW
  status           String   @default("NEW") // NEW, IN_PROGRESS, RESOLVED
  submittedDate    DateTime @default(now())
  resolutionDate   DateTime?
  
  citizenId        String
  citizen          Citizen  @relation(fields: [citizenId], references: [id])
  
  assignedOfficerId String?
  assignedOfficer   User?   @relation(fields: [assignedOfficerId], references: [id])
}

model CertificateApplication {
  id          String   @id @default(uuid())
  type        String   // Residence, Income, Community, Birth
  purpose     String
  status      String   @default("PENDING") // PENDING, ISSUED, REJECTED
  appliedDate DateTime @default(now())
  issuedDate  DateTime?
  
  citizenId   String
  citizen     Citizen  @relation(fields: [citizenId], references: [id])
}

model TaxRecord {
  id              String   @id @default(uuid())
  propertyId      String
  demandAmount    Float
  collectedAmount Float    @default(0)
  balanceDue      Float
  paymentMode     String?  // Cash, Online, Cheque
  receiptNumber   String?
  paymentDate     DateTime?
  
  citizenId       String
  citizen         Citizen  @relation(fields: [citizenId], references: [id])
}

model WaterBody {
  id              String   @id @default(uuid())
  name            String
  type            String   // Pond, Lake, OHT (Overhead Tank)
  wardNumber      String
  capacity        String   // e.g., "60,000 Liters", "~2 Acres"
  status          String   @default("ACTIVE") // ACTIVE, NEEDS_MAINTENANCE, INACTIVE
  lastMaintenance DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model EducationStats {
  id                String   @id @default("VILLAGE_STATS")
  totalSchools      Int      @default(0)
  totalLibraries    Int      @default(0)
  maleLiteracyRate  Float    @default(0)
  femaleLiteracyRate Float   @default(0)
  totalLiteracyRate Float    @default(0)
  updatedAt         DateTime @updatedAt
}

model School {
  id            String   @id @default(uuid())
  name          String
  type          String   // Primary, Higher Sec., Middle, etc.
  wardNumber    String
  address       String
  studentCount  Int      @default(0)
  teacherCount  Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model EducationUpdate {
  id          String   @id @default(uuid())
  title       String
  description String
  date        DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model VillageOfficial {
  id          String   @id @default(uuid())
  name        String
  designation String   // President, Ward Member
  wardNumber  String?  // Null for President
  phoneNumber String?
  photoUrl    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model GramSabhaMeeting {
  id          String   @id @default(uuid())
  topic       String
  date        DateTime
  time        String
  venue       String
  status      String   @default("SCHEDULED") // SCHEDULED, COMPLETED, CANCELLED
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
